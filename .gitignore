# build output
dist/
.astro/

# dependencies
node_modules/

# python (article-health tool — uv toolchain)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# derived content (SSOT is knowledge/; written by scripts/core/sync.sh)
src/content/

# generated build artifacts (regenerated by the prebuild chain; must not enter git)
# — public/kb/*: the /kb/ AI-consumer endpoints + search indexes (build-kb-index, build-search-index)
# — public/llms.txt: the llms.txt boot file (build-kb-index)
# — src/data/*: build-time-import JSON (content-dates, git-info, latest, related)
public/kb/
public/llms.txt
src/data/

# derived worker deploy configs (written by scripts/deploy/gen-worker-config.mjs via
# `npm run worker-config`; they carry this instance's account-scoped worker names,
# database ids, and origin, which must never be committed under workers/)
workers/*/wrangler.generated.toml

# derived corpus embeddings (written by `npm run embeddings:build`). Article titles,
# URLs, and body text are place identity, and workers/ is a code tree that may carry
# none of it — so the retrieval index is rebuilt at deploy time, never committed.
workers/chat/vectors.json

# printable QR sheet (written by `npm run qr:sheet`). It is a print artifact for the
# contexts declared in knowledge/chat/_contexts.md, regenerated whenever those change,
# and it hardcodes this instance's domain — so it is produced on demand, never committed.
qr-sheet.html

# chat evaluation report (written by `npm run chat:eval`). It carries a deployed
# model's answers about this place, is regenerated on every run, and is evidence
# attached to a PR or a verification comment rather than repository content.
reports/chat-eval.md

# visual regression (baseline PNGs are large; commit only the manifest)
reports/visual/baseline/*.png
reports/visual/current/
reports/visual/diff/
reports/visual/diff-report.html
reports/visual/diff-summary.json

# dev-plugin per-machine overrides (the committed config is .agent-toolkit/dev.md)
.agent-toolkit/dev.local.md

# local credentials. Nothing in this repository reads these files — every documented
# operator flow takes credentials from the environment (`npm run embeddings:build`) or
# puts them in Cloudflare (`wrangler secret put`). They are ignored because .dev.vars is
# wrangler's conventional local-secret path and .env is everyone else's, so the moment
# somebody parks a token in one for convenience it must not be stageable.
.env
.env.*
.dev.vars
.dev.vars.*

# os / editor
.DS_Store
