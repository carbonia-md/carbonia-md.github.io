---
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';
import { localizedHome } from '../../lib/place-i18n';

const lang = getLangFromUrl(Astro.url);
const localPath = useTranslatedPath(lang);
const { halls } = localizedHome(lang).exhibitions;
---

<>
  {
    halls.map((hall) => (
      <div class="exhibition-hall">
        <div class="hall-divider">
          <div class="hall-line" />
          <span class="hall-label">{hall.label}</span>
          <div class="hall-line" />
        </div>
        <div class="hall-body">
          {hall.paragraphs.map((para) => (
            <p>
              {para.text}
              <a href={localPath(para.pillHref)} class="topic-pill">
                {para.pillIcon} {para.pillLabel}
              </a>
            </p>
          ))}
        </div>
      </div>
    ))
  }
</>
