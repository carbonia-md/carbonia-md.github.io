---
import { getCollection, render } from 'astro:content';
import ArticleTemplate from '../../../templates/article.template.astro';
import placeConfig from '../../../../place.config';
import { getGitInfo } from '../../../utils/git-info';
import { ENABLED_LANGUAGE_CODES, DEFAULT_LANGUAGE } from '../../../config/languages';
import { loadRelatedData } from '../../../lib/related-data';

export async function getStaticPaths() {
  const validSlugs = new Set(placeConfig.categories.map((c) => c.slug));

  const perLang = await Promise.all(
    ENABLED_LANGUAGE_CODES.map(async (lang) => {
      const articles = await getCollection(lang);
      const related = loadRelatedData(lang);

      const parsed = articles
        .map((article) => {
          const parts = article.id.split('/');
          const category = parts.length > 1 ? parts[0] : 'uncategorized';
          const slug = parts.length > 1 ? parts.slice(1).join('/') : article.id;
          const cleanSlug = slug.replace(/\.md$/, '');
          return { category, slug: cleanSlug, article, data: article.data };
        })
        .filter((entry) => validSlugs.has(entry.category));

      // Lookup "cat/slug" → { title, category, slug } to resolve related ids to link data.
      const byKey = new Map(
        parsed.map((e) => [
          `${e.category}/${e.slug}`,
          { title: e.data.title, category: e.category, slug: e.slug },
        ]),
      );

      return parsed.map((entry) => {
        const key = `${entry.category}/${entry.slug}`;
        const relatedArticles = (related[key] ?? [])
          .map((id) => byKey.get(id))
          .filter((a): a is { title: string; category: string; slug: string } => Boolean(a));
        return {
          params: {
            lang: lang === DEFAULT_LANGUAGE.code ? undefined : lang,
            category: entry.category,
            slug: entry.slug,
          },
          props: {
            article: entry.article,
            lang,
            relatedArticles,
            latestArticles: parsed
              .filter((e) => !(e.category === entry.category && e.slug === entry.slug))
              .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
              .slice(0, 4)
              .map((e) => ({
                title: e.data.title,
                description: e.data.description,
                category: e.category,
                slug: e.slug,
                date: e.data.date,
              })),
          },
        };
      });
    }),
  );

  return perLang.flat();
}

const { category, slug } = Astro.params;
const { article, lang, latestArticles, relatedArticles } = Astro.props;
const { Content, headings } = await render(article);

const wordCount = (article.body ?? '').replace(/\s+/g, ' ').trim().split(' ').length;
const readingTime = Math.max(1, Math.round(wordCount / 200));
const gitInfo = getGitInfo(category!, slug!, lang);
---

<ArticleTemplate
  title={article.data.title}
  description={article.data.description}
  headings={headings}
  frontmatter={article.data}
  category={category!}
  slug={slug!}
  readingTime={readingTime}
  latestArticles={latestArticles}
  relatedArticles={relatedArticles}
  contributors={gitInfo.contributors}
  commitHash={gitInfo.commitHash}
>
  <Content />
</ArticleTemplate>
